{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["tsconfig.json"],
  "entry": ["src/router.tsx", "src/start.ts", "src/routes/**", "src/server/**", "*.config.ts", "*.config.mjs"],
  "ignoreDependencies": ["@tailwindcss/typography", "@semantic-release/git", "semantic-release"],
