{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["tsconfig.json"],
  "entry": [
    "src/router.tsx",
    "src/start.ts",
    "src/routes/**",
    "src/pages/**",
    "src/server/**",
    "*.config.ts",
    "*.config.mjs"
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "@fontsource-variable/geist",
    "@fontsource-variable/lora",
    "@fontsource-variable/space-grotesk",
    "@fontsource/geist-mono",
    "@hookform/resolvers",
    "@tanstack/react-form",
    "@tanstack/react-virtual",
    "class-variance-authority",
    "clsx",
    "cmdk",
    "flexsearch",
    "next-themes",
    "react-day-picker",
    "react-hook-form",
    "recharts",
    "shadcn",
    "tailwind-merge",
    "tailwindcss",
    "tw-animate-css",
    "zustand",
    "@tailwindcss/typography",
    "@semantic-release/git",
    "semantic-release"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
