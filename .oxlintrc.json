{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "node", "react", "jsx-a11y", "typescript", "import", "unicorn", "promise", "react-perf"],
  "jsPlugins": ["eslint-plugin-regexp", "oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/styles/app.css"
    }
  },
  "options": {
    "typeAware": false,
    "typeCheck": false
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "regexp/no-dupe-disjunctions": "warn",
    "regexp/no-empty-character-class": "warn",
    "regexp/no-invalid-regexp": "warn",
    "regexp/no-super-linear-backtracking": "warn",
    "regexp/no-useless-backreference": "warn",
    "regexp/no-useless-escape": "warn",
    "regexp/strict": "warn",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/enforce-consistent-important-position": "warn",
    "tailwindcss/enforce-negative-arbitrary-values": "warn",
    "tailwindcss/no-hardcoded-colors": "warn",
    "tailwindcss/no-unnecessary-arbitrary-value": "warn",
    "eqeqeq": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "typescript/no-base-to-string": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/restrict-template-expressions": "off",
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }]
  },
  "ignorePatterns": ["dist/**", ".output/**", ".vinxi/**", "node_modules/**", "drizzle/**", "**/routeTree.gen.ts"]
}
